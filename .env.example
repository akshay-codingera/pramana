# ====================================================================
# PRAMANA — Environment Configuration Template
# Copy this file to .env for local runtime configuration
# ====================================================================

# Application Server Settings
PORT=3001
NODE_ENV=development

# R Engine Runtime Configuration
# Specify full path to Rscript if not available on system PATH
# Windows Default: D:\Data_AI\01_Software\R\R-4.6.1\bin\Rscript.exe
# Linux / macOS Default: Rscript
RSCRIPT_PATH=D:\Data_AI\01_Software\R\R-4.6.1\bin\Rscript.exe

# Model & Research Data Directories
# Points to local model artifacts and original 23.8 GB research corpus
MODEL_DIR=engine/models
DATA_DIR=D:/Projects/pramana/data

# Pre-Decision Integrity & Upload Limits
ENABLE_PRE_DECISION_MASKING=true
MAX_UPLOAD_SIZE_MB=50
